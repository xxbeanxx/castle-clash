  },
  "devDependencies": {
    "@react-router/dev": "^8.4",
    "@testing-library/react": "^16.3",
    "@types/node": "^24.0",
    "@types/react": "^19.3",
    "@types/react-dom": "^19.3",
    "@vitest/browser": "5.0",
    "@vitest/browser-playwright": "5.0",
    "jsdom": "^30.0",
