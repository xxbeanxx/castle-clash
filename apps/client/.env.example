# Phase 8 (Auth and Persistent State) — dev-only overrides read by
# app/config/runtime.ts's getRuntimeConfig() when window.__CONFIG__ isn't
# set (pnpm dev never serves config.js; see that file's own doc comment).
# Run `pnpm exec supabase start` at the repo root, then `pnpm exec supabase
# status` prints the real API_URL/PUBLISHABLE_KEY values for a local instance.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-your-local-instance-value

# Optional — overrides the ws://localhost:2567 default (see runtime.ts).
# VITE_GAME_SERVER_URL=ws://localhost:2567
