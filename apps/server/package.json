{
  "name": "@castle-clash/server",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "deploy-smoke": "tsx scripts/deploy-smoke.ts",
    "dev": "tsx watch src/index.ts",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt",
    "loadtest": "tsx loadtest/bots.ts",
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "smoke-join": "tsx scripts/smoke-join.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@castle-clash/shared": "workspace:*",
    "@colyseus/monitor": "0.18",
    "@supabase/supabase-js": "2.116.0",
    "colyseus": "0.18",
    "express": "5.2",
    "jose": "6.2.12",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@colyseus/loadtest": "^0.18.2",
    "@colyseus/sdk": "0.18",
    "@colyseus/testing": "^0.18",
    "@types/express": "5.0",
    "@types/node": "^24.0",
    "@types/supertest": "^7.2",
    "supertest": "^7.2",
    "tsx": "^4.23",
    "typescript": "6.0",
    "vitest": "5.0"
  }
}