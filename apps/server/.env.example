# Phase 8 (Auth and Persistent State). Run `pnpm exec supabase start` at the
# repo root first, then `pnpm exec supabase status` prints the real
# API_URL/SECRET_KEY values for a local instance.
#
# Unset (or missing) SUPABASE_URL/SUPABASE_SECRET_KEY: the server falls back
# to InMemoryPlayerRepository for persistence (createPlayerRepository.ts),
# but MatchRoom.onAuth still requires SUPABASE_URL to verify JWTs — a join
# will fail with a clear error until this is set.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=sb_secret_replace-with-your-local-instance-value

PORT=2567
