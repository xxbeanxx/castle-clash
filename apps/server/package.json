{
  "name": "@castle-clash/server",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "smoke-join": "tsx scripts/smoke-join.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@castle-clash/shared": "workspace:*",
    "@colyseus/monitor": "0.18.3",
    "colyseus": "0.18.5",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.2",
    "@colyseus/testing": "^0.18.5",
    "@types/express": "5.0.6",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
