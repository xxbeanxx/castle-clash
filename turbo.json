{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "@castle-clash/client#typecheck": {
      "dependsOn": [
        "^build",
        "build"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "VITE_E2E"
      ],
      "outputs": [
        "dist/**",
        "build/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    }
  }
}