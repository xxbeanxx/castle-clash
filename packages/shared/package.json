{
  "name": "@castle-clash/shared",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@colyseus/schema": "5.0.32"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.0",
    "fast-check": "4.10.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
